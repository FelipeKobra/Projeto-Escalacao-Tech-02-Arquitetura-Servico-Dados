# Copie para .env (que NÃO vai para o git): cp .env.example .env
# Valores de exemplo para ambiente local de estudo; troque as senhas se quiser.

# Banco operacional (fonte)
OLTP_DB_USER=farmarede
OLTP_DB_PASSWORD=troque-me-oltp
OLTP_DB_PORTA=5433

# Data Warehouse
DW_DB_USER=farmarede
DW_DB_PASSWORD=troque-me-dw
DW_DB_PORTA=5434

# Portas no host (mude se já estiverem em uso na sua máquina)
FONTES_PORTA=8081
PLATAFORMA_PORTA=8080
METABASE_PORTA=3000

# Simulador de vendas (fontes-operacionais)
SIMULADOR_HABILITADO=true
SIMULADOR_INTERVALO=10s
SIMULADOR_VENDAS_POR_CICLO=5

# Pipeline (plataforma-dados) - cron do Quarkus (segundos minutos horas dia mês dia-semana)
PIPELINE_HABILITADO=true
PIPELINE_CRON=0 */2 * * * ?

# Usuário e senha do Metabase (ao copiar para .env, preencha METABASE_ADMIN_PASSWORD antes de subir --profile bi)
METABASE_ADMIN_EMAIL=admin@farmarede.local
METABASE_ADMIN_PASSWORD=
